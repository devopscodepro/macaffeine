    "When macOS reports a critical temperature, for example in a closed bag." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يُبلغ macOS عن حرارة حرجة، مثلًا داخل حقيبة مغلقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn macOS eine kritische Temperatur meldet, zum Beispiel in einer geschlossenen Tasche."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫힌 가방 안처럼 macOS가 위험 온도를 알릴 때 적용됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда macOS сообщает о критической температуре, например в закрытой сумке."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อ macOS รายงานอุณหภูมิวิกฤต เช่น อยู่ในกระเป๋าที่ปิด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 macOS 报告温度过高时，例如放在合上的包里。"
          }
        }
      }
    },
    "When the timer ends or a safety rule turns it off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند انتهاء المؤقت أو إيقافه بقاعدة أمان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn der Timer abläuft oder eine Sicherheitsregel es ausschaltet."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "타이머가 끝나거나 안전 규칙이 작동할 때 알립니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
