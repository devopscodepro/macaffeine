    "Add" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавить"
          }
        }
      }
    },
    "Allow Mac to Sleep" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить Mac засыпать"
          }
        }
      }
    },
    "Allow Macaffeine in System Settings → General → Login Items." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Macaffeine в Системных настройках → Основные → Объекты входа."
          }
        }
      }
    },
    "Also Keeping Your Mac Awake" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также не дают Mac уснуть"
          }
        }
      }
    },
    "Also when it locks by itself after the display turns off. Command line and Shortcuts requests keep running." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В том числе когда экран блокируется сам после отключения дисплея. Запросы из командной строки и Быстрых команд продолжат работать."
          }
        }
      }
    },
    "Battery is below %lld%%, your Mac can sleep again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд ниже %lld%%, Mac снова может засыпать."
          }
        }
      }
    },
    "Battery is below %lld%%. Plug in to keep awake." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд ниже %lld%%. Подключите питание, чтобы продолжить."
          }
        }
      }
    },
