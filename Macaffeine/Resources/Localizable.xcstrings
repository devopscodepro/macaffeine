    },
    "Also when it locks by itself after the display turns off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وكذلك عندما تُقفل الشاشة تلقائيًا بعد إيقاف الشاشة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn er sich nach dem Ausschalten des Displays von selbst sperrt."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이가 꺼진 뒤 화면이 자동으로 잠길 때도 포함됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В том числе когда экран блокируется сам после отключения дисплея."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รวมถึงเมื่อหน้าจอล็อกเองหลังจากจอภาพปิด"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括显示器关闭后屏幕自动锁定的情况。"
          }
        }
      }
    },
    "Battery is below %lld%%, your Mac can sleep again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطارية أقل من %lld%%، يمكن لـ Mac السكون مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Akku liegt unter %lld %%, dein Mac darf wieder in den Ruhezustand."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 %lld%% 미만이라 Mac이 다시 잠자기할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд ниже %lld%%, Mac снова может засыпать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบตเตอรี่ต่ำกว่า %lld%% Mac จึงพักได้อีกครั้ง"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池电量低于 %lld%%，Mac 可以重新进入睡眠。"
          }
        }
      }
    },
    "Battery is below %lld%%. Plug in to keep awake." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
