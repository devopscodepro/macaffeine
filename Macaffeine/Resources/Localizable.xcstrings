    "Allow Mac to Sleep" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 잠자기 허용"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить Mac засыпать"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许 Mac 睡眠"
          }
        }
      }
    },
    "Allow Macaffeine in System Settings → General → Login Items." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 일반 → 로그인 항목에서 Macaffeine을 허용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Macaffeine в Системных настройках → Основные → Объекты входа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“通用”→“登录项”中允许 Macaffeine。"
          }
        }
      }
    },
    "Also Keeping Your Mac Awake" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 잠자기를 막고 있는 다른 항목"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Также не дают Mac уснуть"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其他阻止 Mac 睡眠的项目"
          }
        }
      }
    },
    "Also when it locks by itself after the display turns off." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이가 꺼진 뒤 화면이 자동으로 잠길 때도 포함됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В том числе когда экран блокируется сам после отключения дисплея."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包括显示器关闭后屏幕自动锁定的情况。"
          }
        }
      }
    },
    "Battery is below %lld%%, your Mac can sleep again." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 %lld%% 미만이라 Mac이 다시 잠자기할 수 있습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд ниже %lld%%, Mac снова может засыпать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池电量低于 %lld%%，Mac 可以重新进入睡眠。"
          }
        }
      }
    },
    "Battery is below %lld%%. Plug in to keep awake." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리가 %lld%% 미만입니다. 계속하려면 전원을 연결하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд ниже %lld%%. Подключите питание, чтобы продолжить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电池电量低于 %lld%%。请接通电源以继续。"
          }
        }
