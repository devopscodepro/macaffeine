      }
    },
    "Keep your Mac awake while a command runs, for example `macaffeine run -- make`. To install it, run this in Terminal:" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac не уснёт, пока выполняется команда, например `macaffeine run -- make`. Чтобы установить утилиту, выполните в Терминале:"
          }
        }
      }
    },
    "Keeping your Mac awake" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac не уснёт"
          }
        }
      }
