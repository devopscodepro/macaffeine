    "Commands kept awake with `macaffeine run` or `hold` keep running in both cases." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوامر التي تعمل عبر `macaffeine run` أو `hold` تستمر في الحالتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befehle, die mit `macaffeine run` oder `hold` wach gehalten werden, laufen in beiden Fällen weiter."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`macaffeine run` 또는 `hold`로 유지 중인 명령은 두 경우 모두 계속 실행됩니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Команды, запущенные через `macaffeine run` или `hold`, в обоих случаях продолжают работать."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำสั่งที่ใช้ `macaffeine run` หรือ `hold` จะทำงานต่อในทั้งสองกรณี"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 `macaffeine run` 或 `hold` 保持唤醒的命令在这两种情况下都会继续运行。"
          }
        }
      }
