        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac을 잠자기 상태로 전환하거나 덮개를 닫으면 깨어난 후 잠자기 방지가 꺼집니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы усыпили Mac или закрыли крышку, после пробуждения режим будет выключен."
