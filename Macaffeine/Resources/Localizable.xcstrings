    "If the time has already passed today, Macaffeine keeps your Mac awake until that time tomorrow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان هذا الوقت قد مضى اليوم، فسيُبقي Macaffeine جهاز Mac مستيقظًا حتى هذا الوقت غدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist die Uhrzeit heute schon vorbei, hält Macaffeine deinen Mac bis morgen zu dieser Zeit wach."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 이미 지난 시간이면 내일 그 시간까지 Mac이 잠자기하지 않습니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это время сегодня уже прошло, Macaffeine не даст Mac уснуть до этого времени завтра."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากเวลานี้ของวันนี้ผ่านไปแล้ว Macaffeine จะไม่ให้ Mac พักจนถึงเวลานี้ของวันพรุ่งนี้"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果今天已过该时间，Macaffeine 会让 Mac 保持唤醒直到明天的这个时间。"
          }
        }
      }
    },
