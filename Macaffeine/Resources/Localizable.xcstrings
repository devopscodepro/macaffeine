    "Allow Macaffeine in System Settings → General → Login Items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح لـ Macaffeine في إعدادات النظام ← عام ← عناصر تسجيل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Macaffeine in Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 → 일반 → 로그인 항목에서 Macaffeine을 허용하세요."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Macaffeine в Системных настройках → Основные → Объекты входа."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อนุญาต Macaffeine ในการตั้งค่าระบบ → ทั่วไป → รายการเข้าสู่ระบบ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”→“通用”→“登录项”中允许 Macaffeine。"
          }
        }
      }
    },
    "Also Keeping Your Mac Awake" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمنع سكون Mac أيضًا"
          }
